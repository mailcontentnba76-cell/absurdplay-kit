[{"start": 0.0, "end": 4.98, "text": " What the heck? Could the Thunder beat the Blazers if the game was played in a giant Rose Garden?", "words": [[0.0, " What", 0.34], [0.34, " the", 0.54], [0.54, " heck?", 0.86], [1.32, " Could", 1.4], [1.4, " the", 1.56], [1.56, " Thunder", 1.92], [1.92, " beat", 2.14], [2.14, " the", 2.52], [2.52, " Blazers", 2.62], [2.62, " if", 2.94], [2.94, " the", 3.06], [3.06, " game", 3.24], [3.24, " was", 3.44], [3.44, " played", 3.7], [3.7, " in", 3.84], [3.84, " a", 4.06], [4.06, " giant", 4.34], [4.34, " Rose", 4.68], [4.68, " Garden?", 4.98]]}, {"start": 5.5, "end": 12.1, "text": " On Tuesday, Portland beat Oklahoma City 123-103. On Wednesday, they played again. Portland won", "words": [[5.5, " On", 5.6], [5.6, " Tuesday,", 6.02], [6.4, " Portland", 6.6], [6.6, " beat", 6.84], [6.84, " Oklahoma", 7.28], [7.28, " City", 7.62], [7.62, " 123", 8.24], [8.24, "-103.", 9.26], [9.82, " On", 9.92], [9.92, " Wednesday,", 10.3], [10.68, " they", 10.72], [10.72, " played", 10.9], [10.9, " again.", 11.22], [11.74, " Portland", 11.9], [11.9, " won", 12.1]]}, {"start": 12.1, "end": 20.5, "text": " again 118-108. Two nights, two losses. So OKC asks for one small change. Portland is the Rose City,", "words": [[12.1, " again", 12.44], [12.44, " 118", 13.12], [13.12, "-108.", 14.1], [14.56, " Two", 14.74], [14.74, " nights,", 15.0], [15.42, " two", 15.56], [15.56, " losses.", 15.92], [16.52, " So", 16.64], [16.64, " OKC", 17.22], [17.22, " asks", 17.52], [17.52, " for", 17.82], [17.82, " one", 18.12], [18.12, " small", 18.42], [18.42, " change.", 18.82], [19.28, " Portland", 19.5], [19.5, " is", 19.82], [19.82, " the", 20.02], [20.02, " Rose", 20.22], [20.22, " City,", 20.5]]}, {"start": 20.74, "end": 23.66, "text": " so the rematch moves into the biggest Rose Garden in Oregon.", "words": [[20.74, " so", 20.92], [20.92, " the", 21.04], [21.04, " rematch", 21.4], [21.4, " moves", 21.74], [21.74, " into", 22.06], [22.06, " the", 22.2], [22.2, " biggest"